<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:background="@drawable/bg_logo_circle"
            android:gravity="center"
            android:text="☕"
            android:textSize="45sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Create Account"
            android:textColor="@color/coffee_dark"
            android:textSize="29sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"
            android:text="Join us and enjoy your favorite treats."
            android:textColor="@color/coffee_gray"
            android:textSize="14sp"/>

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/bg_input"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="15dp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etRegisterEmail"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="15dp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etRegisterUsername"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Username"
            android:inputType="text"
            android:padding="15dp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etRegisterPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Password (min. 6 characters)"
            android:inputType="textPassword"
            android:padding="15dp"
            android:singleLine="true"/>

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_input"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:padding="15dp"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_button_primary"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="@color/coffee_white"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvRegisterToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Already have an account? Login"
            android:textColor="@color/coffee_primary"
            android:textSize="14sp"/>

    </LinearLayout>

</ScrollView>
