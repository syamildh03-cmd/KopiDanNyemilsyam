<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Profile"
            android:textColor="@color/coffee_dark"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Manage your personal information."
            android:textColor="@color/coffee_gray"
            android:textSize="13sp"/>

        <!-- AVATAR CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_product_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:background="@drawable/bg_logo_circle"
                android:gravity="center"
                android:text="👤"
                android:textSize="44sp"/>

            <TextView
                android:id="@+id/tvProfileGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Halo, Member!"
                android:textColor="@color/coffee_dark"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="member@kopianyemil.com"
                android:textColor="@color/coffee_gray"
                android:textSize="12sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="⭐ Premium Coffee Member"
                android:textColor="@color/coffee_primary"
                android:textSize="11sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- PROFILE SETTINGS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="12dp"
            android:text="Personal Details"
            android:textColor="@color/coffee_dark"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="@color/coffee_dark"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etProfileName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:singleLine="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email Address"
            android:textColor="@color/coffee_dark"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/etProfileEmailInput"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:singleLine="true"/>

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_primary"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/coffee_white"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/btnProfileCart"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_input"
            android:text="My Cart &amp; Orders"
            android:textAllCaps="false"
            android:textColor="@color/coffee_dark"/>

        <Button
            android:id="@+id/btnProfileHome"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_input"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:textColor="@color/coffee_dark"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Logout Account"
            android:textAllCaps="false"
            android:textColor="@color/coffee_red"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:gravity="center"
            android:text="KOPI &amp; NYEMIL v1.0 • Specialty Coffee"
            android:textColor="@color/coffee_gray"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>
