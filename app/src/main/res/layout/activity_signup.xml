<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_logo_circle"
        android:gravity="center"
        android:text="☕"
        android:textSize="60sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Welcome to"
        android:textColor="@color/coffee_gray"
        android:textSize="16sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kopi &amp; Nyemil"
        android:textColor="@color/coffee_dark"
        android:textSize="30sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Your daily premium coffee and snack companion."
        android:textColor="@color/coffee_gray"
        android:textSize="14sp"/>

    <Button
        android:id="@+id/btnGoRegister"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="55dp"
        android:background="@drawable/bg_button_primary"
        android:text="Create Account"
        android:textAllCaps="false"
        android:textColor="@color/coffee_white"
        android:textSize="15sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnGoLogin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/coffee_dark"
        android:textSize="15sp"
        android:textStyle="bold"/>

</LinearLayout>
