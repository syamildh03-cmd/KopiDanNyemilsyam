<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/coffee_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="25dp">

        <TextView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/bg_success_circle"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/coffee_green"
            android:textSize="60sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Pesanan Berhasil!"
            android:textColor="@color/coffee_dark"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvOrderNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_button_secondary"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:text="No. Pesanan: #KN-89241"
            android:textColor="@color/coffee_primary"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Terima kasih sudah memesan di Kopi &amp; Nyemil.\nPesananmu sedang diproses oleh baristas kami."
            android:textColor="@color/coffee_gray"
            android:textSize="13sp"/>

        <!-- ORDER DETAILS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_product_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvConfirmationName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Halo, Nama!"
                android:textColor="@color/coffee_dark"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/coffee_border"/>

            <TextView
                android:id="@+id/tvConfirmationOrder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rincian pesanan..."
                android:textColor="@color/coffee_dark"
                android:textSize="13sp"
                android:lineSpacingExtra="5dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="@color/coffee_border"/>

            <TextView
                android:id="@+id/tvConfirmationAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alamat pengiriman..."
                android:textColor="@color/coffee_gray"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"/>

        </LinearLayout>

        <Button
            android:id="@+id/btnFinish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:text="Kembali ke Home"
            android:textAllCaps="false"
            android:textColor="@color/coffee_white"
            android:textSize="15sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="KOPI &amp; NYEMIL • Enjoy every moment"
            android:textColor="@color/coffee_gray"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>
